+spk_status spk_set_render_window(spk_session* session,
+                                 uint32_t full_w, uint32_t full_h,
+                                 uint32_t win_x, uint32_t win_y, uint32_t win_w, uint32_t win_h,
+                                 uint32_t src_x, uint32_t src_y, uint32_t src_w, uint32_t src_h) {
+    // `full_w/full_h` are the frame the layout is for; `win_*` is a rectangle
+    // of the (larger) canvas, so no relation between them is required here.
+    if (!session) { g_error = "session is null"; return SPK_ERR_INVALID_ARG; }
+    std::lock_guard<std::mutex> guard(session->lock);
+    g_error.clear();
+    Pipeline::RenderWindow window;
+    if (win_w != 0 && win_h != 0) {
+        if (!session->params.film_render.overscan.active) {
+            g_error = "render window: the film edge is off";
+            return SPK_ERR_USER;
+        }
+        if (full_w == 0 || full_h == 0 || src_w == 0 || src_h == 0) {
+            g_error = "render window: the full frame and the source rectangle must be non-empty";
+            return SPK_ERR_INVALID_ARG;
+        }
+        // The canvas is larger than the frame (it carries the rebate), so the
+        // window cannot be bounds-checked here; the film node has the layout
+        // and clamps nothing, but the host cuts the window from the canvas it
+        // asked for with `spk_overscan_layout_at`.
+        window.active = true;
+        window.full_w = full_w; window.full_h = full_h;
+        window.win_x = win_x; window.win_y = win_y; window.win_w = win_w; window.win_h = win_h;
+        window.src_x = src_x; window.src_y = src_y; window.src_w = src_w; window.src_h = src_h;
+    }
+    session->window = window;
+    // A cached negative is a different window's pixels; like a seed change,
+    // the setter invalidates it rather than letting the next render reuse it.
+    for (auto& entry : session->tiers) {
+        spk_session::TierState& state = entry.second;
+        state.negative = Image{};
+        state.has_negative = false;
+        state.overscan_frame_w = state.overscan_frame_h = 0;
+#ifndef __APPLE__
+        state.view_print = Image{};
+#endif
+    }
+    if (session->pipeline) apply_render_window(session);
+    return SPK_OK;
+}
