+/* Patch 0054 -- a window of the film canvas, for an Android tiled export that
+ * cannot render the whole canvas at once. All sizes are pixels of the frame
+ * the session was opened on. `full_w/full_h` are that frame's size, so the
+ * pitch, the gate, the perforation grid and the edge print are the whole
+ * frame's on every tile; `win_*` is the canvas rectangle this render fills;
+ * `src_*` is the frame rectangle the session's source image holds (the host
+ * cuts it out), which lets frame sampling be offset back into it.
+ *
+ * Every tile of one export must use the same full size, seeds and window
+ * origin arithmetic; the canvases then line up pixel for pixel. The output of
+ * `spk_render("full")` is `win_w` x `win_h`. Pass win_w or win_h zero to clear
+ * the window (the shipping whole-frame path, byte for byte). Only valid with
+ * the film edge on. Call after `spk_open` and before the first render. */
+spk_status spk_set_render_window(spk_session* session,
+                                 uint32_t full_w, uint32_t full_h,
+                                 uint32_t win_x, uint32_t win_y, uint32_t win_w, uint32_t win_h,
+                                 uint32_t src_x, uint32_t src_y, uint32_t src_w, uint32_t src_h);
+
+/* The film canvas and gate quads for a whole frame of `w` x `h`, laid out
+ * without rendering. Same JSON as `spk_overscan_geometry`, and the layout is
+ * kept as if a film run had just made it -- so a tiled export can ask where
+ * the canvas is before it cuts the frame into tiles. */
