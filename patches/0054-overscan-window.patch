+    if (!session->pipeline->overscan_layout_at(w, h, error)) { g_error = error; return SPK_ERR_USER; }
+    Json reply;
+    std::string parse_error;
+    const std::string text = session->pipeline->overscan_geometry_json();
+    if (!Json::parse(text, reply, parse_error)) { g_error = "overscan layout: " + parse_error; return SPK_ERR_INTERNAL; }
+    *out_json = dup_json(reply);
+    return SPK_OK;
+}
