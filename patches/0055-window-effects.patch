+void Pipeline::rng_window(uint32_t window_w, uint32_t& full_w, uint32_t& offset,
+                          uint32_t& stride) const {
+    if (!render_window_.active || render_window_.win_w == 0) {
+        full_w = window_w; offset = 0; stride = 0;
+        return;
+    }
+    // The field lives on the film canvas with the edge on, and on the frame
+    // without it. Either way it is the whole plane this window is a crop of.
+    full_w = overscan_wanted() && overscan_.valid && overscan_.canvas_w
+           ? overscan_.canvas_w : render_window_.full_w;
+    if (full_w < window_w) full_w = window_w;
+    offset = render_window_.win_y * full_w + render_window_.win_x;
+    stride = full_w - window_w;
+}
